{
  "name": "muni-worker",
  "private": true,
  "version": "1.0.0-rc.2",
  "description": "Muni API on Cloudflare Workers, D1 and Durable Objects.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/production-config.mjs && wrangler deploy --config wrangler.production.jsonc",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply muni --local",
    "migrate:remote": "node scripts/production-config.mjs && wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "types": "wrangler types"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260925.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.140.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild",
      "sharp"
    ]
  }
}
