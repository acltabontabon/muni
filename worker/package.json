{
  "name": "muni-worker",
  "private": true,
  "version": "0.1.0",
  "description": "Muni API on Cloudflare Workers, D1 and Durable Objects.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply muni --local",
    "migrate:remote": "wrangler d1 migrations apply muni --remote",
    "types": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.141.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild",
      "sharp"
    ]
  }
}
