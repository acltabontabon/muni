{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Template for a production deployment on your own Cloudflare account. Don't edit values here:
  // `pnpm run deploy` renders wrangler.production.jsonc (gitignored) from environment variables —
  // see scripts/production-config.mjs and docs/deployment.md. ${NAME} marks a value it fills in.
  "name": "${MUNI_WORKER_NAME}",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "${MUNI_DOMAIN}", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "${MUNI_D1_DATABASE_NAME}", "database_id": "${MUNI_D1_DATABASE_ID}", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "MeetingRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MeetingRoom"] }],
  // Per-address limit on the signed-out paths, checked before D1 is touched (lib/ratelimit.ts
  // `edgeLimit`). The numbers are EDGE_LIMIT in scripts/production-config.mjs.
  "ratelimits": [
    { "name": "EDGE_LIMIT", "namespace_id": "${MUNI_EDGE_LIMIT_NAMESPACE}", "simple": { "limit": ${MUNI_EDGE_LIMIT_REQUESTS}, "period": ${MUNI_EDGE_LIMIT_PERIOD} } }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_ORIGIN": "https://${MUNI_DOMAIN}",
    // resend | brevo — the API key is a Worker secret: `wrangler secret put RESEND_API_KEY --config wrangler.production.jsonc`.
    // Until it is set, invitation and reminder emails fail with `setup_required` in the job queue
    // (nothing pretends to send; the invite dialog still shows the link to copy).
    "EMAIL_PROVIDER": "${MUNI_EMAIL_PROVIDER}",
    "EMAIL_FROM": "${MUNI_EMAIL_FROM}",
    // The most emails Muni sends in a day, below the provider's own daily quota, so invitations can't
    // use up what reminders need. Past it, an email fails in the job queue, saying so.
    "EMAIL_DAILY_LIMIT": "${MUNI_EMAIL_DAILY_LIMIT}",
    "ALLOW_DEMO_SEED": "false",
    // Passkeys belong to exactly this host (e.g. act.munimuni.app) — not the marketing site, not
    // previews, not other subdomains. If it differs from PUBLIC_ORIGIN's host, every request answers
    // 500 `misconfigured` until it's fixed.
    "WEBAUTHN_RP_ID": "${MUNI_DOMAIN}"
  }
}
