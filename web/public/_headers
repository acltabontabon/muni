# Security headers for every static response (the app shell and its assets), applied by
# Cloudflare Workers static assets. API responses set their own headers in the Worker.
# The app loads nothing from other origins: fonts are self-hosted, the live socket is same-origin,
# and the speech model is served from here too (docs/VOICE.md).
# 'wasm-unsafe-eval' lets the speech worker compile WebAssembly (and nothing else: no eval).
# The microphone is allowed for this origin only; it's used only after a person taps Speak.
# Cross-origin isolation (COOP + COEP) gives the speech model threads; everything is same-origin.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=(), publickey-credentials-create=(self), publickey-credentials-get=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# The service worker must always be re-checked, or updates would wait on the HTTP cache.
/sw.js
  Cache-Control: no-cache

# Content-hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: no-cache

# The speech model: content-addressed by its folder (the pinned revision), fetched only by people
# who use voice, and cached by the speech worker itself.
/voice/*
  Cache-Control: public, max-age=31536000, immutable
