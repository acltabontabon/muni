# Muni server configuration. Copy to .env for local development.
APP_ENV=development                 # development | test | production
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://muni:muni@localhost:5432/muni
DB_MAX_CONNECTIONS=10
PUBLIC_ORIGIN=http://localhost:5173  # the URL people open; must be https:// in production
COOKIE_SECURE=false                  # forced on in production
SESSION_TTL_DAYS=30

# Email: real SMTP delivery. Mailpit (docker compose) listens on 1025 and shows mail at http://localhost:8025
EMAIL_TRANSPORT=smtp                 # smtp | capture (dev/test only: in-memory inbox at /api/dev/inbox)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
EMAIL_FROM=Muni <muni@localhost>

# AI: none (default) | fake (dev/test only) | anthropic
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Serve the built frontend from this directory (production container sets it)
# STATIC_DIR=/app/web
ALLOW_DEMO_SEED=true                 # forced off in production
RUN_WORKER=true
LOG_JSON=false
ENTRY_MAX_CHARS=2000
